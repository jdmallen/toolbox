# EditorConfig — analyzer severities, plus one formatting rule.
#
# This file configures Roslyn analyzer (CAxxxx) severities. Code formatting is
# otherwise governed by the Rider/ReSharper settings in
# JDMallen.Toolbox.sln.DotSettings, so nothing here should fight tab/alignment
# preferences. The one exception is the tab fill style below, recorded here so
# every tool that formats the code (Rider, `jb cleanupcode`) agrees on it.
#
# These overrides reflect deliberate decisions when building under the strict
# `-p:AnalysisMode=All` rule set. Genuine, localized exceptions are handled with
# justified `#pragma warning disable` at the call site instead (e.g. CA1031,
# CA1308); the rules below are blanket policy and belong here, not scattered
# through the code.
root = true

# Indentation, matching committy and shelly. `dotnet format` reads only this
# file (not JDMallen.Toolbox.sln.DotSettings), so it must be set here.

# All files
[*]
indent_style = tab

# Xml files
[*.xml]
indent_size = 2

# Xml project files
[*.{csproj,fsproj,vbproj,proj,slnx}]
indent_size = 2

# Xml config files
[*.{props,targets,config,nuspec}]
indent_size = 2

[*.json]
indent_size = 2

# YAML files (tabs are not allowed in YAML)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# C# files
[*.cs]
indent_size = 4
tab_width = 4

# Rider's "Best fit": tabs indent, and spaces after them nudge continuation
# lines into alignment (e.g. "\t\t\t    || ..."). Mixed leading whitespace is
# therefore intended; don't normalize it to all tabs or all spaces.
resharper_csharp_alignment_tab_fill_style = optimal_fill

# CA1707: Identifiers should not contain underscores.
# Intentional: SCREAMING_CASE private constants and Method_Scenario_Expected test
# names. This is a naming convention, not a defect.
dotnet_diagnostic.CA1707.severity = none

# CA1062: Validate arguments of public methods.
# Redundant with nullable reference types (enabled solution-wide): a non-nullable
# reference parameter already expresses the non-null contract.
dotnet_diagnostic.CA1062.severity = none

# CA2007: Consider calling ConfigureAwait on the awaited task.
# Target frameworks are net10 (ASP.NET, EF) where there is no SynchronizationContext
# to capture, so ConfigureAwait(false) buys nothing. Not worth the call-site noise.
dotnet_diagnostic.CA2007.severity = none

# CA1515: Consider making public types internal.
# This is a library: a broad public surface is the point. The rule targets apps.
dotnet_diagnostic.CA1515.severity = none

# Test projects: relax rules that only make sense for shipped product code.


# CS1574: XML comment has cref attribute that could not be resolved
dotnet_diagnostic.CS1574.severity = none

[test/**/*.cs]

# CA2000: Dispose objects before losing scope.
# Test fixtures (HttpClient, HttpMessageHandler, HttpResponseMessage) are short-lived
# and torn down with the test process; they are not owned by the SUT. Hand-plumbing
# `using` everywhere adds churn without preventing any real leak.
dotnet_diagnostic.CA2000.severity = none

# CA1307: Specify StringComparison for clarity.
# Fires on assertion helpers over ASCII literals; no product logic depends on culture.
dotnet_diagnostic.CA1307.severity = none

# CA1001: Types that own disposable fields should be disposable.
# xUnit v2 fixtures tear down in IAsyncLifetime.DisposeAsync, which xUnit calls;
# the rule doesn't recognize it, so adding IDisposable would be a second,
# redundant dispose path.
dotnet_diagnostic.CA1001.severity = none

# CA1720: Identifier contains type name.
# Test parameters such as `Guid guid` name the value by its type on purpose; the
# rule guards public API names, which tests don't ship.
dotnet_diagnostic.CA1720.severity = none
