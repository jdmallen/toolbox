<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>JDMallen.Toolbox.AI</AssemblyName>
        <RootNamespace>JDMallen.Toolbox.AI</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>JDMallen.Toolbox.AI</PackageId>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Package validation: pack fails on any API break against the
             baseline that isn't recorded in CompatibilitySuppressions.xml. -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>3.2.1</PackageValidationBaselineVersion>

        <Description>Minimal, trim-safe chat completion clients for Anthropic, Azure OpenAI, and any OpenAI-compatible endpoint (including self-hosted models) over raw HTTP with source-generated JSON.</Description>
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

</Project>
