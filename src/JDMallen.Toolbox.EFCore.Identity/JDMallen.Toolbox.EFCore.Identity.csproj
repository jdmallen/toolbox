<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>JDMallen.Toolbox.EFCore.Identity</AssemblyName>
        <RootNamespace>JDMallen.Toolbox.EFCore.Identity</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>JDMallen.Toolbox.EFCore.Identity</PackageId>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Package validation: pack fails on any API break against the
             baseline that isn't recorded in CompatibilitySuppressions.xml. -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>3.2.1</PackageValidationBaselineVersion>

        <Description>ASP.NET Core Identity integration with Entity Framework Core.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\JDMallen.Toolbox.AspNetCore\JDMallen.Toolbox.AspNetCore.csproj"/>
        <ProjectReference Include="..\JDMallen.Toolbox.EFCore\JDMallen.Toolbox.EFCore.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

</Project>
