<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>JDMallen.Toolbox.Hosting</AssemblyName>
        <RootNamespace>JDMallen.Toolbox.Hosting</RootNamespace>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <PackageId>JDMallen.Toolbox.Hosting</PackageId>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Package validation: pack fails on any API break against the
             baseline that isn't recorded in CompatibilitySuppressions.xml. -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>3.2.2</PackageValidationBaselineVersion>

        <Description>Background service base classes with support for scoped services and cron-based scheduling.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
        <PackageReference Include="ncrontab" Version="3.4.0"/>
    </ItemGroup>

    <!-- System.TimeProvider is inbox on .NET 8+; this package supplies the same
         type on netstandard2.0, so both targets share one API. -->

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
      <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.13" />
    </ItemGroup>

</Project>
