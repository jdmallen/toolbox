<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>JDMallen.Toolbox</AssemblyName>
        <RootNamespace>JDMallen.Toolbox</RootNamespace>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <PackageId>JDMallen.Toolbox</PackageId>

        <!-- Package validation: pack fails on any API break against the
             baseline that isn't recorded in CompatibilitySuppressions.xml. -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>3.2.2</PackageValidationBaselineVersion>

        <Description>Core utilities for .NET applications including cryptography, extensions, and data models.</Description>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <!-- System.Text.Json is inbox on net10.0; netstandard2.0 needs the package
         for MiniGuid's converter. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Text.Json" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JDMallen.Toolbox.Data.Abstractions\JDMallen.Toolbox.Data.Abstractions.csproj"/>
    </ItemGroup>

</Project>
